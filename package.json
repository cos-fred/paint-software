{
  "name": "paint-software",
  "version": "1.0.0",
  "description": "Paint Software - Inventory & Sales Tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "init-db": "node -e \"require('./database').initializeDatabase()\"",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "playwright test",
    "restore": "node scripts/restore.js",
    "test:all": "npm test && npm run test:browser"
  },
  "keywords": [
    "inventory",
    "sales",
    "paint",
    "tracker"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "node-gyp": "^13.1.0",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
