# ============================================
# VEEMENZ — environment variables
# Copy to .env and fill in. Never commit .env.
# ============================================

PORT=3000
NODE_ENV=development

# REQUIRED in production: a long random string for signing login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT use a placeholder or short value — production startup refuses weak secrets.
# Rotation: change JWT_SECRET and restart. All existing sessions become invalid
# immediately (users must log in again). Also increment happens automatically on
# password change, role change, and account disable.
JWT_SECRET=

# Optional token lifetime (default 24h). Keep this short; authorization always
# re-checks the current role and account status in the database.
# JWT_EXPIRES_IN=24h

# REQUIRED on first run only: password for the initial "admin" account.
# There is no default password. Use at least 8 characters. It is never reused
# to reset an existing administrator on later startups.
ADMIN_PASSWORD=

# Where the SQLite database lives.
# Local: leave blank (defaults to ./paint_inventory.db)
# Railway volume: /data/paint_inventory.db
# DB_PATH=/data/paint_inventory.db

# Optional: where daily backups are written (defaults to ./backups)
# BACKUP_DIR=/data/backups

# Allowed browser origins (comma-separated). The UI is served by this same
# server, so same-origin requests work with no value.
# Production MUST use explicit https origins — never *.
# CORS_ORIGIN=https://your-app.up.railway.app

# Set to 1 when running behind a reverse proxy (Railway, Render, nginx) so
# login rate limiting uses the real client IP from X-Forwarded-For.
# TRUST_PROXY=1

# Optional login rate limiting (failed attempts only).
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Hourly local backups (default: backups next to DB_PATH, keep 168)
# BACKUP_KEEP=168
# 64 hexadecimal characters; required for independent encrypted copies
# BACKUP_ENCRYPTION_KEY=
# Independently mounted destination; not another folder on the same server disk
# BACKUP_MIRROR_DIR=
# Optional HTTPS PUT receiver; see docs/RECOVERY.md
# BACKUP_REMOTE_URL=
# BACKUP_REMOTE_TOKEN=
# Optional failure notification endpoint (no backup contents or secrets sent)
# BACKUP_ALERT_WEBHOOK_URL=
# Optional exact comma-separated outbound hostnames for notifications/backups
# WEBHOOK_ALLOWED_HOSTS=
# Destructive reset is disabled in production by default
# ALLOW_SYSTEM_RESET=false
# Run one application instance with SQLite
WEB_CONCURRENCY=1
