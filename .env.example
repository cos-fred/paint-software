# ============================================
# VEEMENZ — environment variables
# Copy to .env and fill in for production.
# ============================================

# Port (Railway/Render set this automatically — leave blank locally)
PORT=3000
NODE_ENV=production

# REQUIRED: a long random string for signing login tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database lives.
# Local: leave blank (defaults to ./paint_inventory.db)
# Railway volume: set to the mounted volume path, e.g. /data/paint_inventory.db
# DB_PATH=/data/paint_inventory.db

# Optional: where daily backups are written (defaults to ./backups)
# BACKUP_DIR=/data/backups

# Allowed origins for the API (comma-separated). Use your deployed URL.
CORS_ORIGIN=*

# Optional: override the default admin password on first run
# ADMIN_PASSWORD=admin123
