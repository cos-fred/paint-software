# ============================================
# VEEMENZ — environment variables
# Copy to .env and fill in for production.
# ============================================

# Port (Railway/Render set this automatically — leave blank locally)
PORT=3000
NODE_ENV=production

# REQUIRED in production: a long random string for signing login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT use a placeholder or short value — the app refuses weak secrets in production.
JWT_SECRET=

# REQUIRED on first run: the password for the initial "admin" account.
# There is no default password. Set a strong value; it is only used to create
# the admin on a fresh database, never on subsequent starts.
ADMIN_PASSWORD=

# Where the SQLite database lives.
# Local: leave blank (defaults to ./paint_inventory.db)
# Railway volume: set to the mounted volume path, e.g. /data/paint_inventory.db
# DB_PATH=/data/paint_inventory.db

# Optional: where daily backups are written (defaults to ./backups)
# BACKUP_DIR=/data/backups

# Allowed origins for the API (comma-separated). Use your deployed URL(s).
# The frontend is served by this same server, so same-origin works with no value.
# CORS_ORIGIN=https://your-app.up.railway.app

# Optional login rate limiting (failed attempts only).
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
